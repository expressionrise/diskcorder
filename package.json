{
  "name": "diskcorder",
  "version": "0.3.0",
  "description": "Offline catalog for USB drives — map, annotate, preview video, rename, and copy/move between drives, all searchable when the drive is unplugged.",
  "homepage": "https://github.com/expressionrise/diskcorder#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/expressionrise/diskcorder.git"
  },
  "bugs": {
    "url": "https://github.com/expressionrise/diskcorder/issues"
  },
  "keywords": [
    "electron",
    "sqlite",
    "disk-catalog",
    "usb-drive",
    "video",
    "offline",
    "file-manager"
  ],
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "dist": "electron-builder",
    "pack": "electron-builder --dir"
  },
  "author": "expressionrise",
  "license": "MIT",
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3"
  },
  "build": {
    "appId": "com.expressionrise.diskcorder",
    "productName": "Diskcorder",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe",
        "to": "ffmpeg.exe"
      },
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe.LICENSE",
        "to": "ffmpeg-LICENSE.txt"
      },
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe.README",
        "to": "ffmpeg-README.txt"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "src/renderer/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-${version}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-Portable.${ext}"
    }
  }
}
